# Copy to .env and change values. Never commit .env.
# Optional for `docker compose up -d --build` (every value has a dev default in docker-compose.yml).
# Required when running the backend outside Docker (venv + runserver).
COMPOSE_PROJECT_NAME=event-registration
POSTGRES_DB=event_registration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# Used only when running outside Docker. Inside compose the backend always uses host "db", port 5432.
POSTGRES_HOST=localhost

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Host ports published by docker compose
POSTGRES_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=5500

# Frontend origins (comma separated, no trailing slash). Must match FRONTEND_PORT.
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Backend URL the browser calls (generated into frontend js/config.js by the frontend container).
# Default: http://localhost:${BACKEND_PORT}/api
# API_BASE_URL=http://localhost:8000/api

# Max registration attempts per IP per window: <count>/<s|m|h>
REGISTRATION_RATE_LIMIT=5/m

# Docker only. Dev defaults (admin / admin12345) apply when unset. Never use them for real.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=change-me-admin-password
# SEED_DEMO_DATA=true
